# Copy to .env and fill in. Never commit .env.

# --- Web app (Next.js at repo root) ---
DATABASE_URL="file:./plotstar.db"
# Optional LLM explanations. Never expose this as a NEXT_PUBLIC variable.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"
# Set a long random secret to enable hardware ingest; disabled when empty.
TELEMETRY_API_KEY=""
# Phone app access through scripts/mobile-gateway.mjs; it fills this in when empty.
MOBILE_API_KEY=""
# Optional secured Overpass endpoint. Default public OSM endpoint is used on demand.
OVERPASS_URL="https://overpass-api.de/api/interpreter"
# Optional replacement raster tiles for your deployment.
NEXT_PUBLIC_MAP_TILE_URL="https://tile.openstreetmap.org/{z}/{x}/{y}.png"
# GeoStar data API (services/api)
NEXT_PUBLIC_API_URL="http://localhost:8000"

# --- Data API (services/api) ---
# Extracted CoStar kit, OUTSIDE the repo
COSTAR_KIT_DIR=../PlotStar-data/costar-kit
MATTERPORT_API_KEY=
MATTERPORT_API_TOKEN=
MATTERPORT_SDK_KEY=
VEXCEL_API_KEY=
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=

# Voice (optional). Without a key the UI falls back to the browser voice.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# HAVEN dispatch: real outbound call to the facility's emergency contact (E.164, never 911).
# Needs a Twilio or SIP number imported in ElevenLabs (Agents > Phone numbers).
HAVEN_EMERGENCY_CONTACT=
# Preferred: Cartesia's free US number places the call (no Twilio needed). Optional CARTESIA_PHONE_NUMBER_ID.
CARTESIA_API_KEY=
ELEVENLABS_PHONE_NUMBER_ID=
# Twilio number for HAVEN dispatch; imported into ElevenLabs automatically on first use
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Explainer agent (optional): either key enables the LangChain agent.
ANTHROPIC_API_KEY=

# --- Tello drone bridge (bridge/server.py), used by Design -> Discover ---
DRONE_BRIDGE_URL=http://127.0.0.1:8010

# Google Gemini (AI Studio key, optional). Not used by any feature yet.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Local-conditions data (optional). NREL and EIA fall back to their rate-limited DEMO_KEY; Census needs a free key.
NREL_API_KEY=
EIA_API_KEY=
CENSUS_API_KEY=

# LangSmith tracing for the agent (optional).
LANGSMITH_TRACING=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=plotstar
# LangSmith Sandbox for agent-written analysis code (optional; needs LANGSMITH_API_KEY).
PLOTSTAR_SANDBOX=
PLOTSTAR_SANDBOX_SNAPSHOT=

# Google Maps Platform key (optional; server-side only). Not used by any feature yet.
GOOGLE_MAPS_API_KEY=

# MongoDB Atlas connection string (optional): saves Studio projects and decisions. Without it they stay in the browser.
MONGODB_URI=
MONGODB_DB=plotstar

# Hosted sites whose forwarded /api calls may write to the local workspace (see next.config.ts)
GEOSTAR_ALLOWED_ORIGINS=

# Clerk (sign-in / sign-up); users are saved to MongoDB Atlas on sign-in
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
