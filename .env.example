DATABASE_URL="file:./plotstar.db"
# Optional LLM explanations. Never expose this as a NEXT_PUBLIC variable.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"
# Set a long random secret to enable hardware ingest; disabled when empty.
TELEMETRY_API_KEY=""
# Optional secured Overpass endpoint. Default public OSM endpoint is used on demand.
OVERPASS_URL="https://overpass-api.de/api/interpreter"
# Optional replacement raster tiles for your deployment.
NEXT_PUBLIC_MAP_TILE_URL="https://tile.openstreetmap.org/{z}/{x}/{y}.png"
